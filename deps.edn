{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.6"}
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        org.apache.logging.log4j/log4j-core {:mvn/version "2.26.1"}
        org.apache.logging.log4j/log4j-slf4j2-impl {:mvn/version "2.26.1"}
        ring/ring-core {:mvn/version "1.15.5"}
        ring/ring-jetty-adapter {:mvn/version "1.15.5"}
        ring/ring-json {:mvn/version "0.5.1"}
        ring/ring-devel {:mvn/version "1.15.5"}
        compojure/compojure {:mvn/version "1.7.2"}
        com.github.seancorfield/honeysql {:mvn/version "2.7.1479"}
        com.github.seancorfield/next.jdbc {:mvn/version "1.3.1118"}
        org.postgresql/postgresql {:mvn/version "42.7.13"}
        com.zaxxer/HikariCP {:mvn/version "7.1.0"}
        dev.weavejester/ragtime {:mvn/version "0.12.1"}
        crypto-password/crypto-password {:mvn/version "0.4.0"}
        aero/aero {:mvn/version "1.1.6"}
        hiccup/hiccup {:mvn/version "2.0.0"}}
 :aliases {:dev {:extra-paths ["dev"]
                 :extra-deps {ring/ring-mock {:mvn/version "0.6.2"}}}
           :run {:main-opts ["-m" "endpoint.core"]}
           :test
           {:extra-paths ["test"]
            :extra-deps  {io.github.cognitect-labs/test-runner
                          {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                          ring/ring-mock {:mvn/version "0.6.2"}
                          cheshire/cheshire {:mvn/version "6.2.0"}}
            :exec-fn     cognitect.test-runner.api/test}
           :runner
           {:main-opts   ["-m" "cognitect.test-runner"]}
           :cljfmt {:extra-deps {dev.weavejester/cljfmt {:mvn/version "0.16.5"}}
                    :main-opts ["-m" "cljfmt.main"]}
           :repl {:extra-paths ["dev"]
                  :extra-deps {nrepl/nrepl {:mvn/version "1.7.0"}
                               cider/cider-nrepl {:mvn/version "0.62.2"}}}}}
